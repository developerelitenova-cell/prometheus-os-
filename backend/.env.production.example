# Variables de Entorno BACKEND - PRODUCCIÓN
# Mapear estas variables en el panel de control del servidor (ej. Render o Vercel Backend)

# URL de Producción y Service Key de Supabase (El Service Key TIENE permisos de Admin)
SUPABASE_URL=YOUR_PRODUCTION_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRODUCTION_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET

# Seguridad: CORS (URLs de frontend permitidas)
ALLOWED_ORIGINS=https://tu-dominio-oficial.com,https://www.tu-dominio-oficial.com

# Proveedores de Modelos de IA
ANTHROPIC_API_KEY=YOUR_PRODUCTION_ANTHROPIC_KEY
VOYAGE_API_KEY=YOUR_PRODUCTION_VOYAGE_KEY
