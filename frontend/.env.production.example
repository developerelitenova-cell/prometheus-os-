# Variables de Entorno para PRODUCCIÓN (Usuarios Finales)
# ¡¡IMPORTANTE!! Estas variables NUNCA deben mezclarse con las de STAGING/DEVELOPMENT

# 1. URL y Claves de la nueva Base de Datos de Producción en Supabase
VITE_SUPABASE_URL=YOUR_PRODUCTION_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_PRODUCTION_ANON_KEY

# 2. URL del Backend en Producción
VITE_API_URL=https://your-production-backend-url.com

# 3. Proveedores de IA (pueden ser las mismas, pero controla los costos)
VOYAGE_API_KEY=YOUR_PRODUCTION_VOYAGE_API_KEY
ANTHROPIC_API_KEY=YOUR_PRODUCTION_ANTHROPIC_API_KEY
